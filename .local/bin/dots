#!/usr/bin/env bash

set -euo pipefail

main() {
  ROOT=${DOTFILES:-$HOME/.dotfiles}
  MISE=(mise -C "$ROOT")
  step_seen=''

  if [[ -t 1 ]]; then
    bold=$'\e[1m' dim=$'\e[90m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' reset=$'\e[0m'
  else
    bold='' dim='' red='' green='' yellow='' reset=''
  fi

  local cmd=${1-status}
  if [[ $# -gt 0 ]]; then shift; fi

  case $cmd in
    status | st)    cmd_status "$@" ;;
    sync)           cmd_sync "$@" ;;
    broken)         cmd_broken "$@" ;;
    bs | bootstrap) "${MISE[@]}" bootstrap "$@" ;;
    -h | --help | help) usage ;;
    *) printf '%sdots: unknown command: %s%s\n\n' "$red" "$cmd" "$reset" >&2; usage >&2; exit 2 ;;
  esac
}

usage() {
  cat <<'EOF'
usage: dots [command]

  status        show repo and dotfile state (default)
  sync          pull every repo, then converge this machine
  broken        list dangling links into the repo, offer to remove them
  bs ARGS...    run `mise bootstrap` in the repo (alias: bootstrap)

Anything mise can do is reachable through bs:

  dots bs dotfiles add ~/.config/foo/bar   start managing a path
  dots bs dotfiles apply ~/.zshrc          re-apply one dotfile
  dots bs dotfiles apply -f ~/.zshrc       ... replacing a conflicting file
  dots bs --help                           everything else
EOF
}

# COMMANDS

cmd_status() {
  step 'repos'
  local path_raw path url ref state reason
  while IFS=$'\t' read -r path_raw path url ref state reason; do
    repo_line "$path_raw" "$ref" "$state" "$reason"
  done < <(repos_tsv)

  local dotfiles_state=current dotfiles_detail=''
  if is_dirty "$ROOT"; then dotfiles_state=dirty dotfiles_detail='local changes'; fi

  # shellcheck disable=SC2088
  repo_line '~/.dotfiles' "$(git -C "$ROOT" branch --show-current)" \
    "$dotfiles_state" "$dotfiles_detail"

  step 'dotfiles'
  local json pending
  json=$(spin 'checking dotfiles …' "${MISE[@]}" bootstrap dotfiles status --json)
  pending=$(jq -r '.files[] | select(.state != "applied") | "\(.target)\t\(.state)"' <<<"$json")
  if [[ -n $pending ]]; then
    printf '%s\n' "$pending" | column -ts$'\t' | sed 's/^/  /'
  else
    ok "all $(jq '.files | length' <<<"$json") targets applied"
  fi
}

cmd_sync() {
  step 'pull ~/.dotfiles'
  # shellcheck disable=SC2088
  pull_repo "$ROOT" '~/.dotfiles'

  step 'pull repos'
  local path_raw path url ref state reason
  while IFS=$'\t' read -r path_raw path url ref state reason; do
    if is_repo "$path"; then
      pull_repo "$path" "$path_raw"
    else
      info "$path_raw: cloning $url"
      git clone --quiet --branch "$ref" "$url" "$path"
      ok "$path_raw: cloned"
    fi
  done < <(repos_tsv)

  # repos handled above; mise's own repos step would abort the whole run on any
  # dirty checkout.
  step 'converge'
  "${MISE[@]}" bootstrap -y --skip repos
}

cmd_broken() {
  if [[ $# -gt 0 ]]; then die "broken: unexpected argument: $1"; fi

  local -a dangling=()
  mapfile -t dangling < <(spin 'scanning …' \
    find "$HOME" \( -type d ! -readable -prune \) -o \( -xtype l -lname "$ROOT/*" -print \))

  if [[ ${#dangling[@]} -eq 0 ]]; then
    ok 'no dangling links into the repo'
    return
  fi

  local link target
  for link in "${dangling[@]}"; do
    target=$(readlink "$link")
    printf '  %s%s%s -> %s\n' "$yellow" "${link/#$HOME/\~}" "$reset" "${target/#$HOME/\~}"
  done

  local ans
  printf '\n'
  read -rn1 -p "  remove all ${#dangling[@]}? [y/n] " ans || ans=n
  printf '\n'
  if [[ $ans != [yY] ]]; then
    printf '  %s%d link(s) kept%s\n' "$dim" "${#dangling[@]}" "$reset"
    return
  fi

  local removed=0 failed=0
  for link in "${dangling[@]}"; do
    if rm -- "$link"; then
      removed=$((removed + 1))
    else
      failed=$((failed + 1))
      warn "could not remove ${link/#$HOME/\~}"
    fi
  done

  ok "removed $removed link(s)"
}

# HELPERS

spin() { gum spin --title "$1" --show-output -- "${@:2}"; }
step() { printf '%s%s%s%s\n' "${step_seen:+$'\n'}" "$bold" "$*" "$reset"; step_seen=1; }
info() { printf '  %s\n' "$*"; }
ok()   { printf '  %s%s%s\n' "$green" "$*" "$reset"; }
warn() { printf '  %s%s%s\n' "$yellow" "$*" "$reset"; }
die()  { printf '%sdots: %s%s\n' "$red" "$*" "$reset" >&2; exit 1; }

repos_tsv() {
  spin 'checking repos …' "${MISE[@]}" bootstrap repos status --json |
    jq -r '.repos[] | [.path_raw, .path, .url, .ref, .state, .reason] | @tsv'
}

is_repo()  { [[ -e $1/.git ]]; }
is_dirty() { [[ -n $(git -C "$1" status --porcelain 2>/dev/null) ]]; }

repo_line() {
  local name=$1 ref=$2 state=$3 detail=${4-} color=$yellow
  if [[ $state == current ]]; then color=$green; fi
  printf '  %-32s %-7s %s%s%s\n' "$name" "$ref" "$color" "$state${detail:+: $detail}" "$reset"
}

pull_repo() {
  local path=$1 name=${2:-$1} before after n

  if ! is_repo "$path"; then
    warn "$name: not a git checkout, skipped"
    return
  fi
  if is_dirty "$path"; then
    warn "$name: local changes, not pulling — commit or stash first"
    return
  fi
  if ! git -C "$path" rev-parse '@{u}' >/dev/null 2>&1; then
    warn "$name: no upstream for '$(git -C "$path" branch --show-current)', skipped"
    return
  fi

  before=$(git -C "$path" rev-parse HEAD)
  if ! git -C "$path" pull --ff-only --quiet; then
    warn "$name: pull failed — diverged from upstream?"
    return
  fi
  after=$(git -C "$path" rev-parse HEAD)
  if [[ $before == "$after" ]]; then
    info "$name: up to date"
  else
    n=$(git -C "$path" rev-list --count "$before..$after")
    ok "$name: pulled $n commit(s)"
  fi
}

main "$@"; exit $?
