#compdef dots

_dots_targets() {
  local -a targets
  targets=(${(f)"$(command mise -C ${DOTFILES:-$HOME/.dotfiles} \
    bootstrap dotfiles status --json 2>/dev/null | jq -r '.files[].target' 2>/dev/null)"})

  (( $#targets )) || return 1
  # -Q so the leading ~ isn't quoted to \~; mise accepts both the literal
  # "~/.zshrc" and the path the shell expands it to.
  _wanted dotfiles expl 'managed dotfile' compadd -Q -a targets
}

_dots() {
  local curcontext="$curcontext" state line ret=1
  local -a commands

  commands=(
    'status:show repo and dotfile state'
    'sync:pull every repo, then converge this machine'
    'broken:list dangling links into the repo, offer to remove them'
    'bs:run `mise bootstrap` in the repo'
    'bootstrap:run `mise bootstrap` in the repo'
    'help:show usage'
  )

  _arguments -C \
    '(- 1 *)'{-h,--help}'[show usage]' \
    '1: :->command' \
    '*:: :->argument' && ret=0

  case $state in
    command)
      _describe -t commands 'dots command' commands && ret=0
      ;;
    argument)
      case $words[1] in
        bs | bootstrap)
          # Complete managed targets ourselves for the subcommands that take
          # them.
          if [[ $words[2] == dotfiles ]] \
            && [[ $words[3] == (apply|edit|status|unapply) ]] \
            && [[ $CURRENT -gt 3 ]] \
            && [[ $words[CURRENT] != -* ]]; then
            _dots_targets && ret=0
          else
            words=(mise bootstrap "${(@)words[2,-1]}")
            (( CURRENT += 1 ))
            _mise && ret=0
          fi
          ;;
      esac
      ;;
  esac

  return ret
}

_dots "$@"
